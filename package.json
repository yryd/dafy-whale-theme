{
  "name": "dafy-whale-theme",
  "version": "1.2.1-rc.0",
  "type": "module",
  "main": "index.mjs",
  "description": "蓝色大肥鱼主题：DeepSeek Harness web 前端的海洋配色、游动鱼群与上升气泡。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yryd/dafy-whale-theme.git"
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "theme",
    "web-plugin",
    "blue-whale"
  ],
  "license": "MIT",
  "author": "yryd"
}
